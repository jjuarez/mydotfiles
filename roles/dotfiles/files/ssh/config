#
# JumpHosts
#
Host ibmq.jumphost
  HostName       ibmq-bastion.cloud9.ibm.com
  User           javier.juarez.martin
  ControlMaster  auto
  ControlPath    /tmp/ssh_mux_ibmq.sock
  ControlPersist 8h

Host qnet.jumphost
  HostName       corinthcanal.cloud9.ibm.com
  User           javier.juarez.martin
  ControlMaster  auto
  ControlPath    /tmp/ssh_mux_qnet.sock
  ControlPersist 8h

Host openq.jumphost
  HostName       champlaincanal-nat.watson.ibm.com
  User           javier.juarez.martin
  ControlMaster  auto
  ControlPath    /tmp/ssh_mux_openq.sock
  ControlPersist 8h

# BMT
Host *.bmt.local
  ProxyJump bmt-jump.bromont.can.ibm.com

# EHN
Host *.ehn.local
  ProxyJump ehn2-jump-01.ehningen.de.ibm.com

# SK
Host *.sk.local *.uot.local
  ProxyJump koshiba.hakozaki.ibm.com

Host *.zrl.local
  ProxyJump zrl-jump.zrl.ch.ibm.com

# QNet
Host *.qnet.local
  ProxyJump qnet.jumphost

Host *.ccf.local *.rpi.local *.rkn.local *.yon.local *.bsq.local
  ProxyJump ibmq.jumphost

# OpenQ
Host *.openq.local
  ProxyJump openq.jumphost


# Wireguard GateWay
Host gw.infra.quantum.ibm.com
  User jjuarez


#
# Global options
#
Host *
  User                  javier-juarez-martinez
  UserKnownHostsFile    /dev/null
  StrictHostKeyChecking no
  VerifyHostKeyDNS      no
  ForwardX11            no
  AddKeysToAgent        yes
  ForwardAgent          yes
  TCPKeepAlive          yes
  Compression           yes
  CheckHostIP           no
  SetEnv                LC_ALL="en_US.UTF-8"
