# vim: ft=zsh

#
# Utils
#
utils::check_command() {
  local command="${1:-'none'}"

  case ${command} in
    none) return 1 ;;
       *) return ${command[${command}]} ;;
  esac
}

utils::check_directory() {
  local directory="${1:-'none'}"

  case ${directory} in
    none) return 1 ;;
       *) test -d "${directory}" ;;
  esac
}

utils::check_file() {
  local file="${1:-'none'}"

  case ${file} in
    none) return 1 ;;
       *) test -s "${file}" ;;
  esac
}


#
# Features/Toggles
#
features::artifactory() {
  utils::check_file "${HOME}/.env.IBM.Artifactory.token" || return 1

  source "${HOME}/.env.IBM.Artifactory.token"
}

features::atuin() {
  utils::check_command "autin" || return 1

  eval "$(atuin init zsh)"
}

features::direnv() {
  utils::check_command "direnv" || return 1

  eval "$(direnv hook zsh)"
}

features::ghe() {
  utils::check_file "${HOME}/.env.IBM.GHE.token" || return 1

  source "${HOME}/.env.IBM.GHE.token"
}

features::github() {
  utils::check_file "${HOME}/.env.github.jjuarez.token" || return 1

  source "${HOME}/.env.github.jjuarez.token"
}

features::go() {
  utils::check_file "${HOME}/.gorc" || return 1

  source "${HOME}/.gorc"
}

features::ibmcloud() {
  for acf in QCMaster QSStaging QSProduction QCExperimental; do
    utils::check_file "${HOME}/.env.IBM.Cloud.${acf}.apikey" || return 1

    source "${HOME}/.env.IBM.Cloud.${acf}.apikey"
  done
}

features::krew() {
  utils::check_directory "${HOME}/.krew" || return 1

  export PATH="${PATH}:${HOME}/.krew/bin"
}

features::rust() {
  utils::check_file "${HOME}/.cargo/env" || return 1

  source "${HOME}/.cargo/env"
  export PATH="${HOME}/.cargo/bin:${PATH}"
}

features::tfenv() {
  utils::check_command "tfenv" || return 1

  export PATH="${HOME}/.tfenv/bin:${PATH}"
  export TFENV_AUTO_INSTALL="false"
}

features::volta() {
  utils::check_directory "${HOME}/.volta" || return 1

  export VOLTA_HOME="${HOME}/.volta"
  export PATH="${VOLTA_HOME}/bin:${PATH}"
}

features::zoxide() {
  utils::check_command "zoxide" || return 1

  eval "$(zoxide init zsh --cmd cd)"
}

features::nono() {
  utils::check_command "nono" || return 1
  utils::check_file "${HOME}/.config/nono/profiles/claude-ibm.json" || return 1

  alias claude="nono run --silent --profile claude-ibm --credential ete-litellm --proxy-ca-validity 7 --allow-cwd -- claude"
}

#
# ::main::
#
main() {
  echo -n "Features: "
  for toggle activated in ${(kv)FEATURES_CONFIGURATION}; do
    case "${activated}" in
      true)
        if typeset -f features::${toggle} > /dev/null 2>&1; then
          features::${toggle} && echo -n "${toggle}: ✨ " || echo -n "${toggle}: ❗️ "
        fi
        ;;
      *)
        echo -n "${toggle}: 💔 "
        ;;
    esac
  done
  echo
}

#
# ::main::
#
main
